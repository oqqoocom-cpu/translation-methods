{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["issue_id", "severity", "category", "status", "affected_units", "affected_versions", "description", "synthetic"],
  "properties": {
    "issue_id": {"$ref": "common.schema.json#/$defs/id"},
    "severity": {"enum": ["critical", "major", "minor", "preference"]},
    "category": {"enum": ["accuracy", "omission", "addition", "terminology", "entity", "number", "logic", "reference", "style", "format", "source"]},
    "status": {"enum": ["open", "in-review", "fixed", "closed", "deferred"]},
    "affected_units": {"$ref": "common.schema.json#/$defs/ids"},
    "affected_versions": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/text"}},
    "description": {"$ref": "common.schema.json#/$defs/text"},
    "root_cause": {"$ref": "common.schema.json#/$defs/text"},
    "fix_version": {"$ref": "common.schema.json#/$defs/text"},
    "regression_refs": {"$ref": "common.schema.json#/$defs/ids"},
    "regression_status": {"enum": ["pending", "failed", "passed"]},
    "closed_by": {"$ref": "common.schema.json#/$defs/text"},
    "closed_at": {"type": "string", "format": "date"},
    "synthetic": {"type": "boolean"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"enum": ["fixed", "closed"]}}},
      "then": {
        "required": ["root_cause", "fix_version", "regression_refs", "regression_status"],
        "properties": {"regression_status": {"const": "passed"}}
      }
    },
    {
      "if": {"properties": {"status": {"const": "closed"}}},
      "then": {"required": ["closed_by", "closed_at"]}
    }
  ]
}
