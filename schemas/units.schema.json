{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["role", "language", "version", "units"],
  "properties": {
    "role": {"enum": ["source", "pivot", "target"]},
    "language": {"$ref": "common.schema.json#/$defs/text"},
    "version": {"$ref": "common.schema.json#/$defs/text"},
    "decimal_mark": {"enum": [".", ","]},
    "units": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["unit_id", "text"],
        "properties": {
          "unit_id": {"$ref": "common.schema.json#/$defs/id"},
          "locator": {"$ref": "common.schema.json#/$defs/text"},
          "text": {"type": "string"}
        }
      }
    },
    "synthetic": {"type": "boolean"}
  }
}
